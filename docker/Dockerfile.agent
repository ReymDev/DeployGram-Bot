FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    aiohttp \
    docker \
    psutil \
    python-dateutil

COPY agent/ .
COPY services/docker_manager.py ./services/docker_manager.py
COPY services/archive.py ./services/archive.py
RUN mkdir -p services && touch services/__init__.py

EXPOSE 8080

CMD ["python", "main.py"]
